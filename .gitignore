__pycache__/
*.pyc
*.pyo
.DS_Store
**/.DS_Store

# Node — nunca subir dependencias (Vercel hace npm install en build)
node_modules/
frontend/node_modules/

# Python entornos locales
.venv/
backend/.venv/
venv/

# Lighthouse / auditoría local (mantener solo .gitkeep)
frontend/audit_reports/*
!frontend/audit_reports/.gitkeep

# Secretos / env local (ACCESS_CODE, tokens)
frontend/.env.local
frontend/.env.local*
frontend/.env.*.local
backend/.env
backend/.env.save
backend/.env.*.local

# Temporales de Office / editores
~$*

# Config local Claude / IDE
**/.claude/settings.local.json

# Obsidian (vault local bajo AJUSTES.ALQUIMIA; no versionar layout del editor)
AJUSTES.ALQUIMIA/.obsidian/

# Build output — NO commitear artefactos de build (causan fallos cross-platform en Vercel)
frontend/.next/
frontend/out/
frontend/.turbo/

# Backups binarios locales — guardar fuera de git o en storage/LFS; los manifest sí se versionan
backups/**/*.tgz

# TypeScript incremental (local; cambia en cada tsc y ensucia diffs/PRs)
frontend/tsconfig.tsbuildinfo
.vercel
.env*.local
.env*.save
*.env.save

# ── Anti-desmadre (ALQ-112 limpio) ──────────────────────────────────────────
# Duplicados de Finder/macOS ("archivo 2.py"). Un `git add -A` los barrió a una
# rama (148 archivos) y contaminó el PR #39. No deben entrar nunca más.
* [2-9].py
* [2-9].ts
* [2-9].tsx
* [2-9].js
* [2-9].jsx
* [2-9].mjs
* [2-9].json
* [2-9].md
* [2-9].css
* [2-9].sql
* [2-9].yml
* [2-9].yaml
* [2-9].sh
* [2-9].txt
* [2-9].html
# Env en la raíz (antes solo se ignoraba backend/.env y frontend/.env.local)
.env
# Bases SQLite locales / de CI (alquimia_ci.db se coló en el PR #39)
*.db
*.sqlite
*.sqlite3
# Repos y entornos locales que no son parte de este repo
alquimia-ui-lab/
.venv-pdf/
.tmp_validation/
.pytest_cache/
carpeta sin título/
# Snapshots .zip de handoffs (redundantes con los .md versionados)
etapa de cierre y apertura planeacion/*.zip
